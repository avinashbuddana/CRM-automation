# ============================================================
# SERVER
# ============================================================
PORT=3000
APP_TIMEZONE=Asia/Kolkata

# ============================================================
# ESPOCRM
# ============================================================
# Example: https://neurixa-espocrm.onrender.com
ESPO_URL=

# Create this in:
# EspoCRM -> Administration -> API Users -> Create API User
ESPO_API_KEY=

# Usually Contact. You can also use Lead if you prefer.
ESPO_ENTITY=Contact

# Espo standard fields
ESPO_NAME_FIELD=name
ESPO_PHONE_FIELD=phoneNumber

# Custom Espo fields.
# Espo normally adds "c" to custom field names.
# IMPORTANT: verify the exact names at:
# Administration -> Entity Manager -> Contact -> Fields -> Name
ESPO_BIRTHDATE_FIELD=cBirthDate
ESPO_OPTIN_FIELD=cWhatsAppOptIn
ESPO_LAST_SENT_FIELD=cLastBirthdaySent
ESPO_STATUS_FIELD=cWhatsAppStatus
ESPO_MESSAGE_ID_FIELD=cWhatsAppMessageId

# For the POC this can be false.
# Set true in production so only opted-in customers are messaged.
REQUIRE_WHATSAPP_OPT_IN=false

# For repeat demo testing this can be true.
# Set false in production so a birthday contact cannot be sent twice in the same year.
ALLOW_REPEAT_SEND=true

# Maximum contacts fetched from EspoCRM.
# The service paginates until this limit.
ESPO_MAX_CONTACTS=5000

# ============================================================
# WHATSAPP CLOUD API
# ============================================================
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

# Use the exact APPROVED template name from the SAME WABA.
# Current test template used during this POC:
WHATSAPP_TEMPLATE_NAME=birthdar_wish
WHATSAPP_LANGUAGE_CODE=en

# The birthday template contains one positional variable {{1}} = customer name.
WHATSAPP_TEMPLATE_HAS_NAME=true

META_GRAPH_VERSION=v25.0

# Onboarding / signup confirmation template.
# Triggered once when a new customer is successfully created in EspoCRM
# AND whatsAppOptIn === true.
WHATSAPP_ONBOARDING_TEMPLATE_NAME=customer_signup_confirmation
WHATSAPP_ONBOARDING_LANGUAGE_CODE=en

# Publicly accessible HTTPS image URL used for the template IMAGE header.
# Leave empty if your onboarding template does not use an image header.
WHATSAPP_ONBOARDING_IMAGE_URL=

# ============================================================
# WHATSAPP WEBHOOK
# ============================================================
# Choose your own secret string. This is NOT the Meta access token.
WEBHOOK_VERIFY_TOKEN=neurixa_whatsapp_demo_2026

# ============================================================
# OPTIONAL DAILY AUTOMATION
# ============================================================
# Keep false while demoing with manual Send buttons.
ENABLE_DAILY_JOB=false

# node-cron format. Default = 09:00 every day.
DAILY_CRON=0 9 * * *

# Safety cap for "Send all today's birthdays".
MAX_BULK_SEND=50
